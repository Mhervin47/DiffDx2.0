# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# --- Required ---
GROQ_API_KEY=

# --- Optional: LLM fallback chain / critic (falls back or is skipped if unset) ---
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
CRITIC_MODEL=

# --- Optional: database (falls back to local SQLite if unset) ---
DATABASE_URL=

# --- Optional: transactional email via Resend ---
RESEND_API_KEY=
RESEND_FROM=

# --- Optional: transactional email via SMTP (alternative to Resend; no-ops if SMTP_HOST unset) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Optional: voice features ---
ELEVENLABS_API_KEY=

# --- Optional: multilingual support ---
SARVAM_API_KEY=
